{
  "name": "MyApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build-jsbundle": "npx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios/assets",
    "remove-all": "rm -rf node_modules ios/Pods ios/Podfile.lock && yarn cache clean && yarn install && cd ios && pod install --repo-update && cd .."
  },
